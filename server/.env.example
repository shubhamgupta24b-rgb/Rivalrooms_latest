NODE_ENV=development
PORT=3000
CLIENT_ORIGINS=http://localhost:3000
# Required in production: generate with openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-bytes
ROOM_CODE_LENGTH=6
MAX_ROOM_MEMBERS=10
RECONNECT_GRACE_MS=60000

# Persistent profile and leaderboard storage (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/rivalrooms
DATABASE_SSL=true
DB_POOL_SIZE=5
